# Production / local preview. Development always uses DEV_APP_URL below.
APP_URL=http://127.0.0.1:3018
HOST=127.0.0.1
PORT=3018
DATA_DIR=./data
# PostgreSQL connection for the app and `npm run migrate`. With Docker Compose, set only POSTGRES_PASSWORD;
# compose builds DATABASE_URL for the bundled postgres service, so use a URL-safe password
# (letters, digits, '-', '_' and '.'); characters such as @ : / # % would break the URL.
DATABASE_URL=postgres://campaign:change-me@127.0.0.1:5432/campaign
POSTGRES_PASSWORD=change-me
# Optional: off starts the app without sending due direct campaigns (upgrade verification). Unset or empty means on.
# DIRECT_SCHEDULER=off
DEV_APP_URL=http://127.0.0.1:5178

# Optional: at least 32 random characters. Otherwise generated in DATA_DIR.
# Also derives the encryption key for credentials saved in Integrations.
# Back up this exact value (or DATA_DIR/session-secret) with the database.
# Replacing it makes existing saved integration credentials unreadable.
SESSION_SECRET=

# Optional provider environment fallbacks. Operators can instead configure
# encrypted saved settings and run explicit connection tests in Integrations.
# Saved settings apply immediately and override these fields. Blank secret
# inputs retain credentials; explicit Clear disables environment fallback;
# Use server environment removes the saved provider overrides.
# Editing this file requires a server restart. Maps browser changes also
# require a page reload. Profile/folder/calendar mappings remain project-specific.
ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=
# Register APP_URL/api/webhooks/zernio in Zernio for post and inbox events;
# it must be public HTTPS. Use the same signing secret; see
# https://github.com/Ten98-IO-Company/ten98-campaign/wiki/Unified-Inbox#incoming-updates
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the PEM private key in quotes, with literal \n for line breaks.
# Drive and Calendar share this service account and its saved overrides.
GOOGLE_PRIVATE_KEY=

# OpenRouter models execute remotely; the agent and tools run in this app.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_MAX_TOKENS=2048
OPENROUTER_MAX_STEPS=4

# Google Maps JavaScript API key: browser-visible by design.
# Restrict it to Maps JavaScript API and the allowed app HTTP referrers.
# Enable API access and billing in Google Cloud; use your own production map ID.
GOOGLE_MAPS_BROWSER_API_KEY=
GOOGLE_MAPS_MAP_ID=

# Broadsign Guaranteed Campaigns / Direct. Default to its sandbox.
BROADSIGN_API_KEY=
BROADSIGN_ENVIRONMENT=sandbox
# Optional: require this domain in the verified provider account.
BROADSIGN_DOMAIN_ID=
# The Broadsign account's currency (ISO code, e.g. USD). Required to submit bookings in projects that require ad spend approval.
BROADSIGN_CURRENCY=

# Two-way SMS. A Messaging Service takes priority over FROM_NUMBER.
# Sender registration and carrier charges apply. No voice calls are supported.
# APP_URL must be public HTTPS for signed Twilio delivery callbacks.
# Copy each project's incoming webhook from Unified inbox > SMS replies.
# Preserve its path/query/form bytes; see
# https://github.com/Ten98-IO-Company/ten98-campaign/wiki/Unified-Inbox#twilio-sms-conversations
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Cloudflare Email Sending: transactional messages only, never marketing email.
# Enable the sender domain first. Token needs Email Sending permissions;
# the connection test additionally reads sending domains in the configured zone.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_EMAIL_FROM_ADDRESS=
CLOUDFLARE_EMAIL_FROM_NAME=
# Optional external receiving address (for example an externally routed group).
# Configure/verify forwarding separately; this app has no receiving email inbox.
CLOUDFLARE_EMAIL_REPLY_TO_ADDRESS=

# Amazon SES for direct email. When Cloudflare is also configured, EMAIL_PROVIDER (ses or cloudflare) chooses one.
EMAIL_PROVIDER=
# Least-privilege IAM user: ses:SendEmail on the sender identity and configuration set, and
# ses:GetAccount and ses:GetEmailIdentity for the connection test. Feedback arrives through an
# SNS topic in the same region (SignatureVersion 2) with an HTTPS subscription to
# <APP_URL>/api/webhooks/ses/sns; publish Bounce, Complaint and Delivery events to it from the configuration set.
AWS_SES_REGION=
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_FROM_ADDRESS=
AWS_SES_FROM_NAME=
AWS_SES_REPLY_TO_ADDRESS=
AWS_SES_CONFIGURATION_SET=
AWS_SES_SNS_TOPIC_ARN=

# Branded short-link domains and website origin allowlists are project settings
# in Links & tracking, not environment credentials. See
# https://github.com/Ten98-IO-Company/ten98-campaign/wiki/Links-and-Tracking

# Comma-separated IP addresses or CIDR ranges of reverse proxies whose
# X-Forwarded-For header identifies the client, for example 172.17.0.1 or
# 10.0.0.0/8,fd00::/8. Empty (the default) ignores the header. Sign-in limits per
# 15 minutes: 30 password sign-ins and 30 identity sign-in starts per client
# address, 10 password sign-ins per client for one account, and 50 per account
# from all clients together.
TRUSTED_PROXIES=

# Optional organizational single sign-on (HTTPS issuer).
# Register APP_URL/api/auth/oidc/callback as the redirect URI.
# The provider must sign ID tokens with an asymmetric key, such as RS256, published in its JWKS.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Comma-separated verified emails allowed to create separate OIDC accounts.
# Existing local accounts are never automatically linked by email.
# MFA/password recovery for OIDC accounts is managed by your identity provider.
OIDC_ALLOWED_EMAILS=

# Optional native advertising credentials. Organic SEO/Search Console lives in ten98 Discover.
# Configure these in Integrations instead of this file when preferred.
# Google OAuth needs the adwords scope and an approved developer token.
# Native standard Shopping requires a linked Merchant Center account.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Microsoft OAuth needs msads.manage and offline_access. Secret is optional for public clients.
MICROSOFT_ADS_CLIENT_ID=
MICROSOFT_ADS_CLIENT_SECRET=
MICROSOFT_ADS_REFRESH_TOKEN=
MICROSOFT_ADS_DEVELOPER_TOKEN=
